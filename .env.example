# Web server
PORT=3000

# Default restaurant used by the web form
RESTAURANT_URL=https://restaurante.covermanager.com/mantequilla-social-club/

# Optional defaults for one-shot CLI test (npm run check-once)
START_DATE=2026-07-20
END_DATE=2026-07-31

# Optional checker behavior
CHECK_INTERVAL_MINUTES=5
TIMEZONE=America/Mexico_City
PARTY_SIZE=2

# Date classes interpreted as unavailable. Add more classes if needed.
UNAVAILABLE_CLASSES=complete,close_date

# Notification throttling
NOTIFY_COOLDOWN_MINUTES=60

# Optional location for persisted website configuration
# WATCH_CONFIG_PATH=./data/watch-config.json

# Optional email notification
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
