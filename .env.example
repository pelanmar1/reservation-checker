# Template only. Do not put real secrets in tracked files.

# Web server
PORT=

# Fixed restaurant URL used by the app
RESTAURANT_URL=

# Optional defaults for one-shot CLI test (npm run check-once)
START_DATE=
END_DATE=

# Optional checker behavior
CHECK_INTERVAL_MINUTES=
TIMEZONE=
PARTY_SIZE=

# Date classes interpreted as unavailable
UNAVAILABLE_CLASSES=

# Notification throttling
NOTIFY_COOLDOWN_MINUTES=

# Optional location for persisted website configuration
# WATCH_CONFIG_PATH=./data/watch-config.json

# Optional email notification
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
ALERT_TO=
